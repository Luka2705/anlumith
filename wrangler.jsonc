{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anlumith",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    "not_found_handling": "404-page"
  }
}
